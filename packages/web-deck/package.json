{
  "name": "@pwd/web-deck",
  "version": "0.2.1",
  "description": "Build-free, bilingual presentation framework for PWD lecture pages",
  "main": "web-deck.js",
  "browser": "web-deck.js",
  "style": "web-deck.css",
  "exports": {
    ".": "./web-deck.js",
    "./web-deck.css": "./web-deck.css",
    "./template": "./template/index.html"
  },
  "files": [
    "web-deck.js",
    "web-deck.css",
    "fonts",
    "template",
    "README.md",
    "vendor"
  ],
  "scripts": {
    "test": "node tests/validate.cjs && node scripts/code-examples.cjs --check",
    "format:code": "node scripts/code-examples.cjs --write",
    "check:code": "node scripts/code-examples.cjs --check",
    "vendor:code": "node scripts/vendor-code.cjs"
  },
  "keywords": [
    "slides",
    "presentation",
    "i18n",
    "print"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "htmlhint": "1.9.2",
    "prettier": "3.9.6",
    "prismjs": "1.30.0"
  }
}
